<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <NoWarn>$(NoWarn);CA1416;NU1903</NoWarn>
  </PropertyGroup>

  <!-- Exclude Vite/Node development files and documentation under wwwroot from Publish Output -->
  <ItemGroup>
    <Content Update="wwwroot\**\node_modules\**" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot\**\package.json" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot\**\package-lock.json" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot\**\yarn.lock" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot\**\pnpm-lock.yaml" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot\**\vite.config.*" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot\**\.vite\**" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot\**\README.md" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.16" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
    <PackageReference Include="Piranha" Version="12.2.0" />
    <PackageReference Include="Piranha.AspNetCore" Version="12.2.0" />
    <PackageReference Include="Piranha.AttributeBuilder" Version="12.2.0" />
    <PackageReference Include="Piranha.Manager" Version="12.2.0" />
    <PackageReference Include="Piranha.Manager.LocalAuth" Version="12.2.0" />
    <PackageReference Include="Piranha.Manager.TinyMCE" Version="12.2.0" />
    <PackageReference Include="Piranha.Data.EF.SQLite" Version="12.2.0" />
    <PackageReference Include="Piranha.ImageSharp" Version="12.2.0" />
    <PackageReference Include="Piranha.Local.FileStorage" Version="12.2.0" />

    <!-- Blazor Server + MudBlazor -->
    <PackageReference Include="Blazor-State" Version="10.0.0" />
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageReference Include="MudBlazor" Version="9.7.0" />
    <PackageReference Include="CodeBeam.MudBlazor.Extensions" Version="9.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
  </ItemGroup>

</Project>