@page "/change-password"
@layout Layout.LoginLayout
@attribute [Authorize]

@inject BlazorUserService UserService
@inject NavigationManager Nav
@inject ISnackbar SnackBar
@inject BlazorOptions BlazorOptions

<PageTitle>Dotnet10 Blazor — Change Password</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Change Password</MudText>

@if (isForcedChange)
{
    <MudText Class="mb-4 text-muted"><MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="mr-1" />Hi <strong>@Account.Username</strong>, you are required to update your initial password before accessing the system.</MudText>
}
else
{
    <MudText Class="mb-4">Hi <strong>@Account.Username</strong>, please change your password <MudLink OnClick="@(() => Nav.NavigateTo((!string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl != "/") ? ReturnUrl : BlazorOptions.HomePath, true))">or skip for now.</MudLink></MudText>
}

<MudTextField T="string" InputType="InputType.Password" @bind-Value="@Account.CurrentPassword" name="@nameof(Account.CurrentPassword)" Label="Current Password" Variant="Variant.Outlined" Class="my-6" />
<MudTextField T="string" InputType="InputType.Password" @bind-Value="@Account.NewPassword" name="@nameof(Account.NewPassword)" Label="New Password" Variant="Variant.Outlined" Class="my-6" />
<MudTextField T="string" InputType="InputType.Password" @bind-Value="@Account.RetypePassword" name="@nameof(Account.RetypePassword)" Label="Retype New Password" Variant="Variant.Outlined" Class="my-6" />

<MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" ButtonType="ButtonType.Submit" OnClick="UpdatePasswordClicked" Disabled="isSubmitting">Update Password</MudButton>

@code {
    [CascadingParameter]
    Task<AuthenticationState>? AuthState { get; set; }

    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "username")]
    public string? Username { get; set; }

    [SupplyParameterFromQuery(Name = "forced")]
    public bool ForcedQuery { get; set; }

    public ChangePasswordDTO Account { get; set; } = new ChangePasswordDTO();

    bool isSubmitting = false;
    bool isForcedChange = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (AuthState is not null)
            {
                var state = await AuthState;
                Account.Username = state?.User?.Identity?.Name ?? Username ?? "";

                var dbUser = !string.IsNullOrEmpty(Account.Username)
                    ? await UserService.GetUserByUsernameAsync(Account.Username)
                    : null;

                bool isAdmin = (state?.User?.IsInRole(UserAccount.DEFAULT_ADMIN_ROLENAME) ?? false) ||
                               (state?.User?.IsInRole("Admin") ?? false) ||
                               string.Equals(Account.Username, UserAccount.DEFAULT_ADMIN_LOGIN, StringComparison.OrdinalIgnoreCase) ||
                               (dbUser != null && dbUser.Roles != null && System.Linq.Enumerable.Any(dbUser.Roles.Split(',', StringSplitOptions.RemoveEmptyEntries), r => r.Trim().Equals(UserAccount.DEFAULT_ADMIN_ROLENAME, StringComparison.OrdinalIgnoreCase)));

                isForcedChange = !isAdmin && dbUser != null && dbUser.MustChangePassword;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Blazor ChangePassword Error] {ex.Message}");
            isForcedChange = false;
        }
    }

    void UpdatePasswordClicked()
    {
        isSubmitting = true;
        if (Account.NewPassword == Account.RetypePassword)
        {
            var success = UserService.ChangePassword(Account.Username, Account.CurrentPassword, Account.NewPassword);
            if (success)
            {
                SnackBar.Add("Password updated successfully.", Severity.Success);
                Nav.NavigateTo("logout", true);
            }
            else
            {
                isSubmitting = false;
                clearSnackBars();
                SnackBar.Add("Failed to change password. Please verify current password.", Severity.Error);
            }
        }
        else
        {
            isSubmitting = false;
            clearSnackBars();
            SnackBar.Add("Password does not match.", Severity.Warning);
        }
    }

    void clearSnackBars()
    {
        SnackBar.Clear();
        SnackBar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
    }

    public class ChangePasswordDTO
    {
        public string Username { get; set; } = string.Empty;
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string RetypePassword { get; set; } = string.Empty;
    }
}
