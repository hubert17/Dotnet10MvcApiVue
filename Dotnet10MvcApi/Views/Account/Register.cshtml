@{
    ViewBag.Title = "Sign Up";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="card" id="registerApp" v-cloak>
    <div class="card-body">
        <div class="auth-header text-center">
            <h4 class="card-title">Create an Account</h4>
            <p class="auth-subtitle">Join us today to get started with your account</p>
        </div>

        <form action="/account/Register" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="name" class="form-label">Full Name</label>
                <div class="input-icon-group">
                    <span class="input-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                    </span>
                    <input type="text" id="name" name="name" class="form-control" required autofocus />
                </div>
            </div>

            <div class="form-group">
                <label for="username" class="form-label">Email</label>
                <div class="input-icon-group">
                    <span class="input-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                            <polyline points="22,6 12,13 2,6"/>
                        </svg>
                    </span>
                    <input type="email" id="username" name="username" class="form-control" required />
                </div>
            </div>

            <div class="form-group">
                <label for="password" class="form-label">Password</label>
                <div class="input-icon-group has-toggle">
                    <span class="input-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                    </span>
                    <input v-model="password" :type="showPassword ? 'text' : 'password'" id="password" name="password" class="form-control" required />
                    <button type="button" class="btn-password-toggle" @@click="togglePassword" :title="showPassword ? 'Hide password' : 'Show password'" aria-label="Toggle password visibility">
                        <svg v-if="!showPassword" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                        <svg v-else width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                            <line x1="1" y1="1" x2="23" y2="23"/>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="form-group">
                <label for="retypePassword" class="form-label">Confirm Password</label>
                <div class="input-icon-group has-toggle">
                    <span class="input-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                    </span>
                    <input v-model="retypePassword" :type="showRetypePassword ? 'text' : 'password'" id="retypePassword" name="retypePassword" class="form-control" required />
                    <button type="button" class="btn-password-toggle" @@click="toggleRetypePassword" :title="showRetypePassword ? 'Hide password' : 'Show password'" aria-label="Toggle password visibility">
                        <svg v-if="!showRetypePassword" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                        <svg v-else width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                            <line x1="1" y1="1" x2="23" y2="23"/>
                        </svg>
                    </button>
                </div>
                <div v-if="retypePassword && btnDisabled()" class="match-indicator text-danger">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                    </svg>
                    Passwords do not match
                </div>
            </div>

            <div class="form-group">
                <label class="custom-auth-checkbox">
                    <input type="checkbox" id="agree" name="agree" required />
                    <span class="checkbox-mark">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                    </span>
                    <span class="checkbox-label">I agree to the <a href="#" onclick="event.preventDefault();">Terms and Conditions</a></span>
                </label>
            </div>

            <div class="form-group mb-0">
                <button type="submit" class="btn btn-primary btn-submit" :disabled="btnDisabled()">
                    Create Account
                </button>
            </div>
            <div class="mt-4 text-center auth-footer-text">
                Already have an account? <a href="/account/login">Sign in</a>
            </div>
        </form>
    </div>
</div>

<script type="module">
    import { createApp } from "https://cdn.jsdelivr.net/npm/petite-vue@0.4.1/dist/petite-vue.es.js";
    const app = {
        password: '',
        retypePassword: '',
        showPassword: false,
        showRetypePassword: false,
        btnDisabled() {
            return (this.password && (this.password !== this.retypePassword));
        },
        togglePassword() {
            this.showPassword = !this.showPassword;
        },
        toggleRetypePassword() {
            this.showRetypePassword = !this.showRetypePassword;
        }
    };
    createApp(app).mount("#registerApp");
</script>
