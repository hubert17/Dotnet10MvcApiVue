@{
    ViewData["Title"] = "Direct Messages — Real-Time Chat (MVC)";
}

@* Instagram / X DM Style Real-Time Chat powered by Petite-Vue & SignalR *@

<div id="chat-app" class="container-fluid py-3" v-scope @@vue:mounted="initSignalR()">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
            
            @* Header & Status Bar *@
            <div class="d-flex align-items-center justify-content-between mb-3 px-2">
                <div>
                    <h3 class="h4 mb-0 text-primary font-weight-bold">
                        <i class="fas fa-paper-plane mr-2"></i>Direct Messages
                    </h3>
                    <small class="text-muted">Multi-paradigm real-time SignalR chat (Razor MVC)</small>
                </div>
                <div class="d-flex align-items-center">
                    <span class="badge badge-pill mr-2 p-2" :class="isConnected ? 'badge-success' : 'badge-warning'">
                        <i class="fas" :class="isConnected ? 'fa-circle mr-1' : 'fa-spinner fa-spin mr-1'"></i>
                        {{ isConnected ? 'Live Connected' : 'Connecting...' }}
                    </span>
                </div>
            </div>

            <div class="card shadow-lg border-0 rounded-lg overflow-hidden" style="height: 650px;">
                <div class="row no-gutters h-100">
                    
                    @* Left Sidebar: User Handle & Channels / Contacts *@
                    <div class="col-md-4 col-lg-3 border-right bg-light d-flex flex-column h-100">
                        <div class="p-3 border-bottom bg-white">
                            <label class="small font-weight-bold text-uppercase text-secondary mb-1">Your Handle</label>
                            <div class="input-group input-group-sm">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light text-primary">@@</span>
                                </div>
                                <input type="text" class="form-control font-weight-bold" v-model="myNickname" placeholder="Enter nickname..." />
                            </div>
                        </div>

                        <div class="p-2 border-bottom bg-light">
                            <small class="text-muted font-weight-bold px-2 text-uppercase">Direct Channels</small>
                        </div>

                        <div class="list-group list-group-flush overflow-auto flex-grow-1">
                            <button type="button" 
                                    class="list-group-item list-group-item-action d-flex align-items-center py-3 border-0"
                                    :class="activeRecipient === 'Everyone' ? 'bg-primary text-white' : 'bg-transparent text-dark'"
                                    @@click="activeRecipient = 'Everyone'">
                                <div class="rounded-circle d-flex align-items-center justify-content-center mr-3 font-weight-bold"
                                     :class="activeRecipient === 'Everyone' ? 'bg-white text-primary' : 'bg-primary text-white'"
                                     style="width: 40px; height: 40px;">
                                    <i class="fas fa-globe"></i>
                                </div>
                                <div class="text-truncate">
                                    <div class="font-weight-bold"># Everyone</div>
                                    <small :class="activeRecipient === 'Everyone' ? 'text-white-50' : 'text-muted'">Global public chat channel</small>
                                </div>
                            </button>

                            <button v-for="user in suggestedContacts" 
                                    :key="user"
                                    type="button" 
                                    class="list-group-item list-group-item-action d-flex align-items-center py-3 border-0"
                                    :class="activeRecipient === user ? 'bg-primary text-white' : 'bg-transparent text-dark'"
                                    @@click="activeRecipient = user">
                                <div class="rounded-circle d-flex align-items-center justify-content-center mr-3 font-weight-bold text-uppercase"
                                     :class="activeRecipient === user ? 'bg-white text-primary' : 'bg-secondary text-white'"
                                     style="width: 40px; height: 40px;">
                                    {{ user.substring(0, 2) }}
                                </div>
                                <div class="text-truncate">
                                    <div class="font-weight-bold">@@{{ user }}</div>
                                    <small :class="activeRecipient === user ? 'text-white-50' : 'text-muted'">Direct message</small>
                                </div>
                            </button>
                        </div>
                    </div>

                    @* Right Main Pane: Chat Messages Thread & Input Box *@
                    <div class="col-md-8 col-lg-9 d-flex flex-column h-100 bg-white">
                        
                        @* Header for active recipient *@
                        <div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-white">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mr-3 font-weight-bold text-uppercase" style="width: 38px; height: 38px;">
                                    {{ activeRecipient === 'Everyone' ? '🌎' : activeRecipient.substring(0, 2) }}
                                </div>
                                <div>
                                    <h6 class="mb-0 font-weight-bold">
                                        {{ activeRecipient === 'Everyone' ? 'Global Channel (#Everyone)' : '@@' + activeRecipient }}
                                    </h6>
                                    <small class="text-success"><i class="fas fa-circle mr-1" style="font-size: 8px;"></i>Active SignalR Circuit</small>
                                </div>
                            </div>
                            <button class="btn btn-sm btn-outline-secondary" @@click="messages = []" title="Clear view">
                                <i class="fas fa-trash-alt mr-1"></i>Clear
                            </button>
                        </div>

                        @* Message Thread Scroll Box *@
                        <div class="flex-grow-1 p-3 overflow-auto d-flex flex-column" id="chat-messages-box" style="background-color: #f8f9fa;">
                            <div v-if="filteredMessages.length === 0" class="m-auto text-center py-5 text-muted">
                                <i class="far fa-comments fa-3x mb-3 text-secondary"></i>
                                <h5>No messages yet</h5>
                                <p class="small">Say hi to {{ activeRecipient }} to start the conversation!</p>
                            </div>

                            <div v-for="(msg, idx) in filteredMessages" :key="idx" 
                                 class="d-flex flex-column mb-3"
                                 :class="msg.sender === myNickname ? 'align-items-end' : 'align-items-start'">
                                
                                <small class="text-muted px-1 mb-1" style="font-size: 11px;">
                                    <span class="font-weight-bold" :class="msg.sender === myNickname ? 'text-primary' : 'text-dark'">
                                        {{ msg.sender === myNickname ? 'You' : '@@' + msg.sender }}
                                    </span> 
                                    &bull; {{ formatTime(msg.timestamp) }}
                                </small>

                                <div class="px-3 py-2 rounded-lg shadow-sm max-w-75"
                                     :class="msg.sender === myNickname ? 'bg-primary text-white rounded-bottom-right-0' : 'bg-white text-dark border rounded-bottom-left-0'"
                                     style="max-width: 75%; word-break: break-word;">
                                    {{ msg.message }}
                                </div>
                            </div>
                        </div>

                        @* Input Controls *@
                        <div class="p-3 border-top bg-white">
                            <form @@submit.prevent="sendMessage" class="input-group">
                                <input type="text" 
                                       class="form-control py-4 border-right-0" 
                                       v-model="newMessage" 
                                       placeholder="Type a message..." 
                                       :disabled="!isConnected" />
                                <div class="input-group-append">
                                    <button class="btn btn-primary px-4 font-weight-bold" type="submit" :disabled="!isConnected || !newMessage.trim()">
                                        <i class="fas fa-paper-plane mr-1"></i>Send
                                    </button>
                                </div>
                            </form>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@7.0.5/dist/browser/signalr.min.js"></script>
    <script type="module">
        import { createApp } from 'https://cdn.jsdelivr.net/npm/petite-vue@@0.4.1/dist/petite-vue.es.js';

        const defaultUser = 'User_' + Math.floor(Math.random() * 899 + 100);

        createApp({
            myNickname: defaultUser,
            activeRecipient: 'Everyone',
            suggestedContacts: ['DevUser', 'Alex', 'Jordan', 'Support'],
            newMessage: '',
            messages: [],
            isConnected: false,
            hubConnection: null,

            get filteredMessages() {
                return this.messages.filter(m => 
                    this.activeRecipient === 'Everyone' || 
                    m.recipient === 'Everyone' ||
                    m.recipient === this.myNickname ||
                    m.sender === this.myNickname ||
                    m.sender === this.activeRecipient
                );
            },

            formatTime(ts) {
                if (!ts) return '';
                const d = new Date(ts);
                return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            },

            async initSignalR() {
                this.hubConnection = new signalR.HubConnectionBuilder()
                    .withUrl('/chathub')
                    .withAutomaticReconnect()
                    .build();

                this.hubConnection.on('ReceiveChatMessage', (dto) => {
                    this.messages.push(dto);
                    this.scrollToBottom();
                });

                try {
                    await this.hubConnection.start();
                    this.isConnected = true;
                } catch (err) {
                    console.error('SignalR connection error:', err);
                    setTimeout(() => this.initSignalR(), 3000);
                }
            },

            async sendMessage() {
                if (!this.newMessage.trim() || !this.isConnected) return;

                const text = this.newMessage;
                this.newMessage = '';

                try {
                    await this.hubConnection.invoke('SendMessage', this.myNickname, this.activeRecipient, text);
                } catch (err) {
                    console.error('Failed to send chat message:', err);
                }
            },

            scrollToBottom() {
                setTimeout(() => {
                    const el = document.getElementById('chat-messages-box');
                    if (el) el.scrollTop = el.scrollHeight;
                }, 50);
            }
        }).mount('#chat-app');
    </script>
}
