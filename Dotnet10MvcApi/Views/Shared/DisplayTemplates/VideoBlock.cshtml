@model Piranha.Extend.Blocks.VideoBlock

@if (Model.Body != null && Model.Body.HasValue)
{
    <div class="text-center my-4">
        <video class="mw-100 rounded shadow" controls>
            <source src="@Url.Content(Model.Body.Media?.PublicUrl)">
            Your browser does not support the video tag.
        </video>
    </div>
}
