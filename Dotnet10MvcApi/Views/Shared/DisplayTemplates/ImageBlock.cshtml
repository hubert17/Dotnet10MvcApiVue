@model Piranha.Extend.Blocks.ImageBlock

@if (Model.Body != null && Model.Body.HasValue)
{
    <div class="text-center my-4">
        <img class="img-fluid rounded d-block mx-auto shadow"
             src="@Url.Content(Model.Body.Media?.PublicUrl)"
             alt="@(Model.Body.Media?.AltText ?? Model.Body.Media?.Filename)" />
    </div>
}
