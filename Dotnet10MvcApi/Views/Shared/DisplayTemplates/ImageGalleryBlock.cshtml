@model Piranha.Extend.Blocks.ImageGalleryBlock
@using Piranha.Extend.Blocks
@{
    var unique = "gallery-" + Guid.NewGuid().ToString("N");
    var images = Model.Items
        .Where(i => i.GetType() == typeof(ImageBlock) && ((ImageBlock)i).Body.HasValue)
        .Cast<ImageBlock>()
        .ToList();
}

@if (images.Any())
{
    <div id="@unique" class="carousel slide my-4" data-ride="carousel">
        <ol class="carousel-indicators">
            @for (var n = 0; n < images.Count; n++)
            {
                <li data-target="#@unique" data-slide-to="@n" class="@(n == 0 ? "active" : "")"></li>
            }
        </ol>
        <div class="carousel-inner rounded" style="background: rgba(0,0,0,0.3);">
            @foreach (var item in images)
            {
                <div class="carousel-item @(item == images.First() ? "active" : "")">
                    <img src="@Url.Content(item.Body.Media?.PublicUrl)"
                         class="d-block w-100"
                         alt="@item.Body.Media?.AltText"
                         style="max-height: 450px; object-fit: cover;" />
                </div>
            }
        </div>
        <a class="carousel-control-prev" href="#@unique" role="button" data-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="carousel-control-next" href="#@unique" role="button" data-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="sr-only">Next</span>
        </a>
    </div>
}
