@model Dotnet10MvcApi.Models.Cms.Blocks.HeroBlock

<div class="cms-hero-banner my-4 p-5 rounded-3 border text-center text-md-left position-relative overflow-hidden" 
     style="background: radial-gradient(circle at 10% 20%, rgba(99, 102, 241, 0.25) 0%, rgba(6, 182, 212, 0.1) 50%, rgba(11, 15, 25, 0.8) 100%); border-color: rgba(99, 102, 241, 0.3) !important; backdrop-filter: blur(12px);">
    
    @if (Model.Badge != null && !string.IsNullOrWhiteSpace(Model.Badge.Value))
    {
        <span class="badge badge-pill px-3 py-2 mb-3 d-inline-block" style="background: rgba(99, 102, 241, 0.2); color: #818cf8; font-weight: 600; border: 1px solid rgba(99, 102, 241, 0.4);">
            <i class="fa-solid fa-sparkles mr-1"></i> @Model.Badge.Value
        </span>
    }

    @if (Model.Title != null && !string.IsNullOrWhiteSpace(Model.Title.Value))
    {
        <h2 class="display-4 font-weight-bold text-white mb-3">@Model.Title.Value</h2>
    }

    @if (Model.Subtitle != null && !string.IsNullOrWhiteSpace(Model.Subtitle.Value))
    {
        <p class="lead text-muted mb-4" style="max-width: 760px; line-height: 1.6;">@Model.Subtitle.Value</p>
    }

    @if (Model.ButtonText != null && !string.IsNullOrWhiteSpace(Model.ButtonText.Value))
    {
        <a href="@(string.IsNullOrWhiteSpace(Model.ButtonUrl?.Value) ? "#" : Model.ButtonUrl.Value)" class="btn btn-cms-action px-4 py-2 font-weight-semibold">
            @Model.ButtonText.Value <i class="fa-solid fa-arrow-right ml-1"></i>
        </a>
    }
</div>
