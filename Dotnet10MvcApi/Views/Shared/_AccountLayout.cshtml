@inject Dotnet10MvcApi.Models.MvcOptions MvcOptions
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewBag.Title - @MvcOptions.AppName</title>
    <meta name="Name" content="@ViewBag.Title - @MvcOptions.AppName" />
    <meta name="Description" content="@MvcOptions.AppDescription" />
    <meta property="og:title" content="@ViewBag.Title - @MvcOptions.AppName" />
    <meta property="og:description" content="@MvcOptions.AppDescription" />

    @if (TempData["alert"] != null)
    {
        <script>
            alert('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(TempData["alert"]?.ToString()))');
        </script>
    }

    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    @* Google Fonts: Inter & Plus Jakarta Sans *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">

    @* Bootstrap 4 CSS & Account CSS *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Account.css" asp-append-version="true" />

    @RenderSection("head", required: false)
</head>

<body class="my-login-page">
    @* Ambient mesh background decorations *@
    <div class="auth-bg-decor" aria-hidden="true">
        <div class="bg-glow bg-glow-1"></div>
        <div class="bg-glow bg-glow-2"></div>
    </div>

    <section class="auth-wrapper">
        <div class="container min-vh-100 d-flex flex-column justify-content-center align-items-center py-4">
            <div class="card-wrapper">
                <div class="brand text-center mb-4">
                    <a href="@MvcOptions.HomePath" title="Go to homepage" class="brand-link">
                        <div class="brand-icon-box">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                            </svg>
                        </div>
                    </a>
                </div>

                @RenderBody()

                <div class="footer mt-4 text-center">
                    <p>&copy; @DateTime.Now.Year - Bernard Gabon. All rights reserved.</p>
                </div>
            </div>
        </div>
    </section>

    @* jQuery first, then Popper.js, then Bootstrap JS *@
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootbox@5.5.3/bootbox.min.js"></script>

    @if (TempData["alertbox"] != null)
    {
        <script>
            bootbox.alert('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(TempData["alertbox"]?.ToString()))');
        </script>
    }

    @RenderSection("scripts", required: false)
</body>
</html>
