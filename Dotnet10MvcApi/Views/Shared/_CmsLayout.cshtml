<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Platform Insights &amp; Articles</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 4.6.2 & FontAwesome via jsDelivr CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@6.4.2/css/all.min.css">
    
    <style>
        :root {
            --cms-bg: #0b0f19;
            --cms-card-bg: #141c2e;
            --cms-text: #f1f5f9;
            --cms-text-muted: #94a3b8;
            --cms-primary: #6366f1;
            --cms-primary-hover: #4f46e5;
            --cms-secondary: #06b6d4;
            --cms-accent: #ec4899;
            --cms-gradient: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #d946ef 100%);
            --cms-gradient-cyan: linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);
            --cms-border: rgba(255, 255, 255, 0.08);
            --cms-glow: rgba(99, 102, 241, 0.25);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--cms-bg);
            color: var(--cms-text);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        h1, h2, h3, h4, h5, h6, .brand-title {
            font-family: 'Outfit', sans-serif;
        }

        /* Glassmorphic Navbar */
        .cms-navbar {
            background: rgba(11, 15, 25, 0.85) !important;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--cms-border);
            position: sticky;
            top: 0;
            z-index: 1030;
            transition: all 0.3s ease;
        }

        .cms-brand {
            font-size: 1.5rem;
            font-weight: 800;
            color: #fff !important;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .cms-brand .brand-badge {
            background: var(--cms-gradient);
            padding: 0.25rem 0.6rem;
            border-radius: 8px;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #fff;
        }

        .nav-link-cms {
            color: #cbd5e1 !important;
            font-weight: 600;
            padding: 0.6rem 1.2rem !important;
            border-radius: 10px;
            transition: all 0.2s ease-in-out;
        }

        .nav-link-cms:hover, .nav-link-cms.active {
            color: #fff !important;
            background: rgba(255, 255, 255, 0.06);
            transform: translateY(-1px);
        }

        /* Hero Headers */
        .cms-hero {
            background: radial-gradient(circle at 50% 0%, rgba(99, 102, 241, 0.18) 0%, rgba(11, 15, 25, 0) 70%);
            padding: 4rem 0 3rem;
            position: relative;
            overflow: hidden;
        }

        .cms-hero-title {
            font-size: 3.2rem;
            font-weight: 800;
            background: linear-gradient(135deg, #ffffff 30%, #a5b4fc 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 1rem;
        }

        .cms-hero-desc {
            font-size: 1.2rem;
            color: var(--cms-text-muted);
            max-width: 680px;
            line-height: 1.6;
        }

        /* Card Modern Design */
        .cms-card {
            background: var(--cms-card-bg);
            border: 1px solid var(--cms-border);
            border-radius: 20px;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            overflow: hidden;
        }

        .cms-card:hover {
            transform: translateY(-8px);
            border-color: rgba(99, 102, 241, 0.4);
            box-shadow: 0 20px 40px var(--cms-glow);
        }

        .cms-badge-category {
            background: rgba(99, 102, 241, 0.15);
            color: #a5b4fc;
            border: 1px solid rgba(99, 102, 241, 0.3);
            font-weight: 600;
            font-size: 0.8rem;
            padding: 0.35rem 0.85rem;
            border-radius: 9999px;
        }

        .cms-badge-article {
            background: rgba(6, 182, 212, 0.15);
            color: #67e8f9;
            border: 1px solid rgba(6, 182, 212, 0.3);
            font-weight: 600;
            font-size: 0.8rem;
            padding: 0.35rem 0.85rem;
            border-radius: 9999px;
        }

        .btn-cms-action {
            background: var(--cms-gradient);
            color: #fff !important;
            font-weight: 700;
            border: none;
            border-radius: 12px;
            padding: 0.6rem 1.4rem;
            box-shadow: 0 4px 14px var(--cms-glow);
            transition: all 0.2s ease;
        }

        .btn-cms-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px var(--cms-glow);
            opacity: 0.95;
        }

        .btn-cms-outline {
            background: transparent;
            color: #cbd5e1 !important;
            border: 1px solid var(--cms-border);
            border-radius: 12px;
            font-weight: 600;
            padding: 0.6rem 1.4rem;
            transition: all 0.2s ease;
        }

        .btn-cms-outline:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: #a5b4fc;
            color: #fff !important;
        }

        /* Article & Blog Content Typography */
        .cms-article-container {
            background: var(--cms-card-bg);
            border: 1px solid var(--cms-border);
            border-radius: 24px;
            padding: 3rem;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
        }

        .cms-article-container h1, .cms-article-container h2, .cms-article-container h3, .cms-article-container h4 {
            color: #fff;
            margin-top: 2rem;
            margin-bottom: 1rem;
            font-weight: 700;
        }

        .cms-article-container p {
            color: #cbd5e1;
            font-size: 1.125rem;
            line-height: 1.8;
            margin-bottom: 1.5rem;
        }

        .cms-article-container code {
            background: rgba(99, 102, 241, 0.15);
            color: #c7d2fe;
            padding: 0.2rem 0.5rem;
            border-radius: 6px;
            font-size: 0.9em;
        }

        .cms-article-container pre {
            background: #090d16;
            border: 1px solid var(--cms-border);
            border-radius: 14px;
            padding: 1.25rem;
            color: #38bdf8;
            overflow-x: auto;
        }

        .cms-article-container ul, .cms-article-container ol {
            color: #cbd5e1;
            font-size: 1.1rem;
            line-height: 1.8;
            margin-bottom: 1.5rem;
            padding-left: 1.5rem;
        }

        /* Footer */
        .cms-footer {
            margin-top: auto;
            background: #080c14;
            border-top: 1px solid var(--cms-border);
            padding: 3rem 0 2rem;
            color: var(--cms-text-muted);
        }

        .cms-footer a {
            color: #cbd5e1;
            transition: color 0.2s;
        }

        .cms-footer a:hover {
            color: var(--cms-secondary);
            text-decoration: none;
        }
    </style>
</head>
<body>

    <!-- Youthful & Elegant Glassmorphism Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark cms-navbar py-3">
        <div class="container">
            <a class="navbar-brand cms-brand" href="/blogs">
                <i class="fa-solid fa-sparkles text-indigo text-warning"></i>
                Platform Insights
                <span class="brand-badge">CMS v12</span>
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-toggle="collapse" data-target="#cmsNavbarContent" aria-controls="cmsNavbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="cmsNavbarContent">
                <ul class="navbar-nav ml-auto align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link nav-link-cms" href="/"><i class="fa-solid fa-house mr-1"></i> Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-cms" href="/blogs"><i class="fa-solid fa-blog mr-1"></i> Blogs</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-cms" href="/articles"><i class="fa-solid fa-newspaper mr-1"></i> Articles</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-cms" href="/home"><i class="fa-solid fa-cubes mr-1"></i> MVC Site</a>
                    </li>
                    <li class="nav-item ml-lg-2 mt-2 mt-lg-0">
                        <a href="/manager" class="btn btn-cms-action btn-sm px-3" target="_blank">
                            <i class="fa-solid fa-sliders mr-1"></i> Manager Portal
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Dynamic Content Body -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Modern Youthful Footer -->
    <footer class="cms-footer">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 mb-3 mb-md-0">
                    <h5 class="text-white font-weight-bold mb-1">
                        <i class="fa-solid fa-bolt text-warning mr-2"></i> Platform Insights &amp; CMS Hub
                    </h5>
                    <p class="small text-muted mb-0">Powered by Piranha CMS v12 on ASP.NET Core .NET 10</p>
                </div>
                <div class="col-md-6 text-md-right">
                    <a href="/blogs" class="mr-3">Blogs</a>
                    <a href="/articles" class="mr-3">Articles</a>
                    <a href="/manager" class="mr-3" target="_blank">CMS Manager</a>
                    <a href="/">Landing Page</a>
                </div>
            </div>
            <hr style="border-color: var(--cms-border);" class="my-4" />
            <div class="d-flex justify-content-between align-items-center small text-muted">
                <span>&copy; @DateTime.Now.Year Bernard Gabon. All rights reserved.</span>
                <div>
                    <span class="mr-3"><i class="fa-solid fa-database text-info mr-1"></i> SQLite + EF Core</span>
                    <span><i class="fa-solid fa-shield-halved text-success mr-1"></i> Security Enabled</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Core Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
